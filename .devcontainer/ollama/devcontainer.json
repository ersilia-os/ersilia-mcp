{
  // Uses Ollama to download and run a small LLM locally (no API key, no
  // hosted CLI) -- see docs/mcp_setup/ollama.md for the full setup.
  "name": "ersilia-mcp-local-llm",
  // Conda is not optional: .mcp.json launches the server with
  // `conda run -n ersilia-mcp`, so the env name must match exactly.
  "image": "mcr.microsoft.com/devcontainers/miniconda:3",
  "features": {
    // Ersilia serves models as containers and Isaura runs MinIO via compose.
    // Docker-in-Docker (rather than docker-outside-of-docker) keeps Isaura's
    // ~/minio-data bind mount resolving inside the codespace.
    "ghcr.io/devcontainers/features/docker-in-docker:2": {
      "moby": false
    }
  },
  // Sized for Ollama's qwen3:4b (~6GB resident, see docs/mcp_setup/ollama.md)
  // running alongside the Ersilia/Isaura containers docker-in-docker brings
  // up, not just the lighter qwen3:1.7b default.
  "hostRequirements": {
    "cpus": 8,
    "memory": "32gb"
  },
  "onCreateCommand": "bash .devcontainer/ollama/setup.sh",
  "postAttachCommand": "bash .devcontainer/start-store.sh && bash .devcontainer/ollama/start-ollama.sh",
  "forwardPorts": [9000, 9001, 11434],
  "portsAttributes": {
    "9000": {
      "label": "MinIO API",
      "onAutoForward": "silent"
    },
    "9001": {
      "label": "MinIO console",
      "onAutoForward": "silent"
    },
    "11434": {
      "label": "Ollama API",
      "onAutoForward": "silent"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": ["charliermarsh.ruff", "ms-python.python"],
      "settings": {
        "python.defaultInterpreterPath": "/opt/conda/envs/ersilia-mcp/bin/python",
        "python.testing.pytestEnabled": true,
        "[python]": {
          "editor.defaultFormatter": "charliermarsh.ruff"
        }
      }
    }
  },
  "remoteUser": "vscode"
}
